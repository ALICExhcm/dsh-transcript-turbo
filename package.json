{
  "name": "dsh-transcript-turbo",
  "version": "0.5.0",
  "description": "Render acceleration for long formula-heavy transcripts in the DSH web UI: offscreen message blocks skip style/layout/paint, and per-frame SVG spinner animations are replaced with a near-zero-cost opacity pulse.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REPLACE-WITH-YOUR-GITHUB-USERNAME/dsh-transcript-turbo.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "performance",
    "content-visibility",
    "katex",
    "transcript"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "manifestVersion": 1
  },
  "icon": "./icon.svg",
  "license": "MIT"
}
